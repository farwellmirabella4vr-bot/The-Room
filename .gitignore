node_modules/

# OS/editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# local env/secrets, if any ever get added
.env
.env.local

# Nest of Knowledge Sync's local bridge folder -- live, personal Obsidian
# vault content synced from a real vault, not project source. Never belongs
# in version control.
nest-of-knowledge/

# Curriculum companion audio/PDFs (e.g. get-farsi-audio.ps1's output) --
# publisher-owned copyrighted content fetched from the publisher's own site,
# not ours to redistribute via a public repo. Regenerate locally by re-running
# the matching get-<language>-audio.ps1 script; audio-index.json is its
# generated manifest, so it's excluded too rather than drifting from the
# actual downloaded files.
data/curriculum/*/audio/
data/curriculum/*/docs/
data/curriculum/*/audio-index.json

# process-textbook-video.js's output -- real photographs of copyrighted
# textbook pages (from your own overhead-webcam video) and the
# classification report describing them. Regenerate locally by re-running
# the script against the source video; never redistribute via a public repo.
data/curriculum/*/textbook-images/
textbook-video-report*.json

# tools/book-video (video -> curriculum pipeline) -- all local intermediates.
# frames/ are stills of copyrighted textbook pages from your own video; ocr/ is
# the text read off them; the rest are derived working files. Regenerate locally
# by re-running the numbered stage scripts. The finished module is written to
# data/curriculum/es/ and IS committed.
tools/book-video/frames/
tools/book-video/ocr/
tools/book-video/.batches/
tools/book-video/tessdata/
tools/book-video/_*/
tools/book-video/pages.json
tools/book-video/page-sequence-report.txt
tools/book-video/scene-scores.txt
tools/book-video/book-structure*.json
